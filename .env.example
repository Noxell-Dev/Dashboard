# Copia este archivo a `.env` y rellena con los datos de tu proyecto de Supabase.
# (Supabase → Project Settings → Database → Connection string)

# App y seed: usa la cadena con POOL de conexiones (puerto 6543, incluye ?pgbouncer=true).
# Es la recomendada para Vercel y otros entornos serverless.
DATABASE_URL="postgresql://postgres:[TU-CONTRASEÑA]@db.[REF-PROYECTO].supabase.co:6543/postgres?pgbouncer=true"

# Migraciones: usa la cadena de conexión DIRECTA (puerto 5432).
DIRECT_URL="postgresql://postgres:[TU-CONTRASEÑA]@db.[REF-PROYECTO].supabase.co:5432/postgres"
